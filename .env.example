# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/vnkr_trade"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=14d

# ── OAuth2 ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VNKR Trade <noreply@vnkr.vn>"

# ── CCXT ─────────────────────────────────────────────────────
CCXT_EXCHANGE=binance
CCXT_SANDBOX=true
CCXT_API_KEY=
CCXT_API_SECRET=

# ── Frontend public vars ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SITE_NAME="VNKR Trade"
NEXT_PUBLIC_SITE_URL=https://trading.vnkr.vn
