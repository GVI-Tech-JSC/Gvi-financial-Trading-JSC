# ============================================================
# VNKR Trade — Backend Development ENV (DEBUG MODE)
# Author: NGUYEN THI THU HUONG | GVI Tech JSC
# ============================================================
NODE_ENV=development
BACKEND_PORT=4001
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# Database
DATABASE_URL="mysql://root:password@localhost:3306/vnkr_trade_dev"

# Redis
REDIS_URL=redis://localhost:6379

# JWT (dev keys — change in production)
JWT_SECRET=vnkr-dev-secret-2025
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=14d

# CCXT — sandbox mode (no real trades)
CCXT_EXCHANGE=binance
CCXT_SANDBOX=true
CCXT_API_KEY=
CCXT_API_SECRET=

# OAuth2 (optional for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (use ethereal.email for dev testing)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VNKR Trade Dev <dev@vnkr.vn>"

# App
APP_URL=http://localhost:3001
SITE_NAME="Gvi-financial-Trading-JSC"
SITE_URL=https://vnkr.vn
