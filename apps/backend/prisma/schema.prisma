generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum WalletType {
  FIAT
  SPOT
  ECO
  FUTURES
  COPY_TRADING
}

enum TxType {
  DEPOSIT
  WITHDRAW
  TRANSFER
  TRADE
  FEE
  BONUS
  REFERRAL
  STAKING
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVIEWING
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LIMIT
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELED
  EXPIRED
  REJECTED
}

enum TimeInForce {
  GTC
  IOC
  FOK
  PO
}

enum KycStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum StakingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum P2pOfferStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum P2pTradeStatus {
  PENDING
  PAID
  APPEALING
  COMPLETED
  CANCELLED
}

enum BinaryResult {
  WIN
  LOSS
  DRAW
}

enum FuturesSide {
  LONG
  SHORT
}

enum FuturesStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

enum NotifChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum ExtStatus {
  ACTIVE
  INACTIVE
}

// ── USER & ACCESS ──────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  email            String?    @unique
  password         String?
  firstName        String?
  lastName         String?
  avatar           String?
  phone            String?
  emailVerified    Boolean    @default(false)
  phoneVerified    Boolean    @default(false)
  role             String     @default("user")
  kycLevel         Int        @default(0)
  status           UserStatus @default(ACTIVE)
  referralCode     String?    @unique
  referredById     String?
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  walletAddress    String?
  walletProvider   String?
  lastLogin        DateTime?
  settings         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  wallets          Wallet[]
  transactions     Transaction[]
  exchangeOrders   ExchangeOrder[]
  futuresPositions FuturesPosition[]
  binaryOrders     BinaryOrder[]
  kycApplications  KycApplication[]
  supportTickets   SupportTicket[]
  notifications    Notification[]
  sessions         LoginSession[]
  apiKeys          ApiKey[]
  stakingPositions StakingPosition[]
  p2pOffers        P2pOffer[]
  mlmReferrals     MlmReferral[]     @relation("Referrer")
  mlmReferred      MlmReferral[]     @relation("Referred")
  auditLogs        AuditLog[]

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  action      String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model LoginSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_sessions")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  permissions String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ── WALLET & FINANCE ───────────────────────────────────────────────────────────

model Wallet {
  id           String     @id @default(uuid())
  userId       String
  currency     String
  type         WalletType @default(SPOT)
  balance      Decimal    @default(0) @db.Decimal(30, 8)
  lockedBalance Decimal   @default(0) @db.Decimal(30, 8)
  address      String?
  memo         String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, type])
  @@map("wallets")
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  currency    String
  amount      Decimal   @db.Decimal(30, 8)
  fee         Decimal   @default(0) @db.Decimal(30, 8)
  type        TxType
  status      TxStatus  @default(PENDING)
  reference   String?
  txHash      String?
  description String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model DepositAddress {
  id        String   @id @default(uuid())
  userId    String
  currency  String
  network   String
  address   String
  memo      String?
  createdAt DateTime @default(now())

  @@unique([userId, currency, network])
  @@map("deposit_addresses")
}

// ── EXCHANGE ────────────────────────────────────────────────────────────────────

model ExchangeOrder {
  id          String      @id @default(uuid())
  userId      String
  symbol      String
  side        OrderSide
  type        OrderType
  status      OrderStatus @default(OPEN)
  price       Decimal?    @db.Decimal(30, 8)
  amount      Decimal     @db.Decimal(30, 8)
  filled      Decimal     @default(0) @db.Decimal(30, 8)
  remaining   Decimal     @db.Decimal(30, 8)
  cost        Decimal?    @db.Decimal(30, 8)
  fee         Decimal     @default(0) @db.Decimal(30, 8)
  timeInForce TimeInForce @default(GTC)
  clientId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  closedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
  @@index([symbol, status])
  @@map("exchange_orders")
}

// ── FUTURES ─────────────────────────────────────────────────────────────────────

model FuturesPosition {
  id               String        @id @default(uuid())
  userId           String
  symbol           String
  side             FuturesSide
  status           FuturesStatus @default(OPEN)
  leverage         Int           @default(1)
  margin           Decimal       @db.Decimal(30, 8)
  size             Decimal       @db.Decimal(30, 8)
  entryPrice       Decimal       @db.Decimal(30, 8)
  markPrice        Decimal?      @db.Decimal(30, 8)
  liquidationPrice Decimal?      @db.Decimal(30, 8)
  unrealizedPnl    Decimal       @default(0) @db.Decimal(30, 8)
  realizedPnl      Decimal       @default(0) @db.Decimal(30, 8)
  fundingFee       Decimal       @default(0) @db.Decimal(30, 8)
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("futures_positions")
}

// ── BINARY OPTIONS ──────────────────────────────────────────────────────────────

model BinaryOrder {
  id         String       @id @default(uuid())
  userId     String
  symbol     String
  direction  String
  amount     Decimal      @db.Decimal(30, 8)
  payout     Decimal      @default(0) @db.Decimal(30, 8)
  entryPrice Decimal?     @db.Decimal(30, 8)
  exitPrice  Decimal?     @db.Decimal(30, 8)
  status     String       @default("PENDING")
  result     BinaryResult?
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, expiresAt])
  @@map("binary_orders")
}

// ── KYC ────────────────────────────────────────────────────────────────────────

model KycApplication {
  id              String    @id @default(uuid())
  userId          String
  level           Int       @default(1)
  status          KycStatus @default(PENDING)
  fullName        String?
  idType          String?
  idNumber        String?
  dob             String?
  nationality     String?
  address         String?
  frontImageUrl   String?
  backImageUrl    String?
  selfieUrl       String?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_applications")
}

// ── STAKING ────────────────────────────────────────────────────────────────────

model StakingPool {
  id           String    @id @default(uuid())
  name         String
  currency     String
  apy          Float
  minAmount    Decimal   @db.Decimal(30, 8)
  lockDays     Int       @default(0)
  totalStaked  Decimal   @default(0) @db.Decimal(30, 8)
  status       ExtStatus @default(ACTIVE)
  autoCompound Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  positions StakingPosition[]

  @@map("staking_pools")
}

model StakingPosition {
  id            String        @id @default(uuid())
  userId        String
  poolId        String
  amount        Decimal       @db.Decimal(30, 8)
  accruedReward Decimal       @default(0) @db.Decimal(30, 8)
  status        StakingStatus @default(ACTIVE)
  stakedAt      DateTime      @default(now())
  unlocksAt     DateTime
  unstakedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool StakingPool @relation(fields: [poolId], references: [id])

  @@index([userId, status])
  @@map("staking_positions")
}

// ── P2P ────────────────────────────────────────────────────────────────────────

model P2pOffer {
  id             String         @id @default(uuid())
  userId         String
  type           OrderSide
  currency       String
  fiatCurrency   String
  price          Decimal        @db.Decimal(30, 8)
  minAmount      Decimal        @db.Decimal(30, 8)
  maxAmount      Decimal        @db.Decimal(30, 8)
  available      Decimal        @db.Decimal(30, 8)
  paymentMethod  String
  terms          String?        @db.Text
  status         P2pOfferStatus @default(ACTIVE)
  escrowLocked   Decimal        @default(0) @db.Decimal(30, 8)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades P2pTrade[]

  @@index([type, currency, status])
  @@map("p2p_offers")
}

model P2pTrade {
  id             String         @id @default(uuid())
  offerId        String
  buyerId        String
  sellerId       String
  amount         Decimal        @db.Decimal(30, 8)
  fiatAmount     Decimal        @db.Decimal(30, 8)
  status         P2pTradeStatus @default(PENDING)
  paymentProof   String?
  disputeReason  String?
  resolvedBy     String?
  paidAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  offer P2pOffer @relation(fields: [offerId], references: [id])

  @@map("p2p_trades")
}

// ── AFFILIATE / MLM ────────────────────────────────────────────────────────────

model MlmReferral {
  id             String   @id @default(uuid())
  referrerId     String
  referredId     String
  level          Int      @default(1)
  commissionRate Float    @default(0)
  totalCommission Decimal @default(0) @db.Decimal(30, 8)
  createdAt      DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@map("mlm_referrals")
}

model AffiliateCommission {
  id            String   @id @default(uuid())
  referrerId    String
  referredId    String
  sourceOrderId String?
  amount        Decimal  @db.Decimal(30, 8)
  currency      String   @default("USDT")
  level         Int
  status        String   @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([referrerId])
  @@map("affiliate_commissions")
}

// ── ECOSYSTEM (On-chain) ───────────────────────────────────────────────────────

model EcoBlockchain {
  id          String    @id @default(uuid())
  name        String    @unique
  symbol      String
  chainId     Int?
  rpcUrl      String?
  explorerUrl String?
  nativeCoin  String
  status      ExtStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tokens EcoToken[]

  @@map("eco_blockchains")
}

model EcoToken {
  id              String        @id @default(uuid())
  blockchainId    String
  name            String
  symbol          String
  contractAddress String?
  decimals        Int           @default(18)
  status          ExtStatus     @default(ACTIVE)
  depositEnabled  Boolean       @default(true)
  withdrawEnabled Boolean       @default(true)
  minDeposit      Decimal       @default(0) @db.Decimal(30, 8)
  minWithdraw     Decimal       @default(0) @db.Decimal(30, 8)
  withdrawFee     Decimal       @default(0) @db.Decimal(30, 8)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  blockchain EcoBlockchain @relation(fields: [blockchainId], references: [id])

  @@map("eco_tokens")
}

model EcoWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String   @unique
  network   String
  index     Int
  createdAt DateTime @default(now())

  @@map("eco_wallets")
}

// ── COMPLIANCE ─────────────────────────────────────────────────────────────────

model ComplianceAlert {
  id          String    @id @default(uuid())
  userId      String
  type        String
  severity    String    @default("LOW")
  description String    @db.Text
  txId        String?
  status      String    @default("OPEN")
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@map("compliance_alerts")
}

model ComplianceBlacklist {
  id         String   @id @default(uuid())
  identifier String   @unique
  type       String
  reason     String?
  addedBy    String?
  createdAt  DateTime @default(now())

  @@map("compliance_blacklist")
}

// ── NOTIFICATIONS ──────────────────────────────────────────────────────────────

model Notification {
  id        String       @id @default(uuid())
  userId    String
  title     String
  message   String       @db.Text
  type      String       @default("INFO")
  channel   NotifChannel @default(IN_APP)
  isRead    Boolean      @default(false)
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ── CMS — BLOG ─────────────────────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(uuid())
  authorId    String
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     String   @db.LongText
  category    String?
  tags        Json?
  status      String   @default("draft")
  viewCount   Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("blog_posts")
}

// ── CMS — LEARN ────────────────────────────────────────────────────────────────

model LearnCourse {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String?      @db.Text
  level       String       @default("beginner")
  category    String?
  duration    Int?
  status      String       @default("draft")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons LearnLesson[]

  @@map("learn_courses")
}

model LearnLesson {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String   @db.LongText
  order     Int      @default(0)
  duration  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
  @@map("learn_lessons")
}

// ── SUPPORT TICKET ─────────────────────────────────────────────────────────────

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  priority  String       @default("NORMAL")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  message   String   @db.Text
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

// ── SYSTEM ─────────────────────────────────────────────────────────────────────

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  group     String   @default("general")
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}
